{
  "name": "processloop",
  "version": "0.1.0",
  "private": true,
  "description": "Process Dashboard (GPLv3) fork - Next.js port with en/ja i18n",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
